FROM ocr-docker-remote.artifactory.oci.oraclecorp.com/os/oraclelinux:9
COPY --from=odo-docker-signed-local.artifactory.oci.oraclecorp.com/base-image-support/ol9:1.50 / /

ARG JETTY_VERSION=12.0.33
ARG JETTY_REPO_BASE=https://repo1.maven.org/maven2
ARG OPENSSH_VERSION=8.7p1-49.0.1.el9_7

# =============================================================================
# Environment setup
# =============================================================================
ENV LANG=en_US.utf8
ENV LC_ALL=en_US.utf8

# =============================================================================
# System Dependencies
# =============================================================================


RUN dnf clean all && \
    dnf install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        dnf-plugin-versionlock \
        curl wget less lsof openssl-1:3.5.1-7.0.1.el9_7 openssl-libs-1:3.5.1-7.0.1.el9_7 vim-minimal unzip zip git \
        gcc make zlib-devel bzip2 bzip2-devel readline-devel \
        sqlite sqlite-devel openssl-devel xz xz-devel libffi-devel \
        findutils tar gzip && \
    dnf versionlock delete 'openssh*' || true && \
    dnf --refresh install -y --setopt=install_weak_deps=False \
        openssh-${OPENSSH_VERSION} \
        openssh-clients-${OPENSSH_VERSION} \
        openssh-server-${OPENSSH_VERSION} && \
    dnf versionlock add openssh-${OPENSSH_VERSION} openssh-clients-${OPENSSH_VERSION} openssh-server-${OPENSSH_VERSION} && \
    dnf update -y kernel-headers-5.14.0-570.58.1.0.1.el9_6 && \
    dnf clean all && rm -rf /var/cache/dnf /var/log/dnf*

# =============================================================================
# Install Python 3.12 via Oracle AppStream
# =============================================================================
RUN dnf -y install python3.12 python3.12-pip python3.12-wheel python3.12-devel \
    && python3.12 -m pip install --upgrade pip==25.3 \
    && python3.12 -m pip install setuptools==80.10.2 \
    && dnf clean all \
    && rm -rf /var/cache/dnf
    
RUN rm -rf /usr/lib/python3.12/site-packages/pip* \
           /usr/lib/python3.12/site-packages/pip-22.3.1.dist-info

RUN rm -f /usr/bin/python /usr/bin/pip && \
    ln -s /usr/bin/python3.12 /usr/bin/python && \
    ln -s /usr/bin/pip3.12 /usr/bin/pip
# =============================================================================
# Application Setup
# =============================================================================
WORKDIR /app

# Copy dependency files first to use Docker cache
COPY ./pyproject.toml ./uv.lock ./

# Install uv
# ENV PATH="/root/.local/bin:$PATH"
ENV PATH="/root/.local/bin:$PATH" \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_NO_CACHE_DIR=off \
    PYTHONDONTWRITEBYTECODE=true \
    PYTHONFAULTHANDLER=true \
    PYTHONUNBUFFERED=true \
    PIP_TRUSTED_HOST=artifactory.oci.oraclecorp.com \
    PIP_INDEX_URL=https://artifactory.oci.oraclecorp.com/api/pypi/global-release-pypi/simple/ \
    PIP_INDEX_URL_DEV=https://artifactory.oci.oraclecorp.com/api/pypi/global-dev-pypi/simple \
    LC_ALL=en_US.utf8 \
    LANG=en_US.utf8 \
    TRUST_HOST_1=pypi.python.org \
    TRUST_HOST_2=pypi.org \
    TRUST_HOST_3=files.pythonhosted.org

RUN pip install uv==0.9.10

# Copy cdrc application code
COPY . /app/

RUN uv sync

# Patch the embedded chainsaw2 Jetty runtime to the latest secure Jetty release
RUN set -euxo pipefail \
    && chainsaw_jar="/opt/lumberjack/chainsaw2/lib/chainsaw2-2.0.226-prod_release.jar" \
    && if [ -f "${chainsaw_jar}" ]; then \
         tmpdir="$(mktemp -d)" \
         && cleanup() { rm -rf "${tmpdir}"; } \
         && trap cleanup EXIT \
         && cd "${tmpdir}" \
         && unzip -qo "${chainsaw_jar}" \
         && rm -rf org/eclipse/jetty \
         && jetty_modules="jetty-server jetty-http jetty-io jetty-util jetty-util-ajax jetty-security jetty-xml jetty-servlet jetty-servlets jetty-webapp jetty-client" \
         && for module in ${jetty_modules}; do \
              module_url="${JETTY_REPO_BASE}/org/eclipse/jetty/${module}/${JETTY_VERSION}/${module}-${JETTY_VERSION}.jar" \
              && curl -fsSL --retry 3 "${module_url}" -o "${module}-${JETTY_VERSION}.jar" \
              && unzip -qo "${module}-${JETTY_VERSION}.jar" \
              && rm -f "${module}-${JETTY_VERSION}.jar"; \
            done \
         && find META-INF -type f \( -name '*.SF' -o -name '*.RSA' -o -name '*.DSA' -o -name '*.EC' \) -delete \
         && zip -qr "${chainsaw_jar}" . \
         && cleanup \
         && trap - EXIT \
         && cd /; \
       else \
         echo "chainsaw2 jar not present; skipping Jetty patch"; \
       fi

# Ensure the uv-managed virtual environment is on PATH for runtime
ENV PATH="/app/.venv/bin:$PATH"

# Expose the port
EXPOSE 8002

# Set Python path for the application
ENV PYTHONPATH="/app/cdrc:$PYTHONPATH"


RUN chmod +x cdrc/profees_coding/deploy/api/entrypoint.sh

# Use the entrypoint script
ENTRYPOINT ["cdrc/profees_coding/deploy/api/entrypoint.sh"]
